# Copie este arquivo para .env e preencha. O .env NÃO vai para o repositório.

# Conexão com o PostgreSQL.
# Neon: painel do projeto > Connection string > copie a URL inteira.
DATABASE_URL=postgresql://usuario:senha@host/connectpatas?sslmode=require

# Banco usado pelos testes automatizados. Precisa ser OUTRO banco:
# a suíte apaga e recria as tabelas a cada execução.
DATABASE_URL_TEST=postgresql://usuario:senha@host/connectpatas_test?sslmode=require

# Segredo que assina o cookie de sessão. Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-este-valor

PORT=3001
# Origem do frontend em desenvolvimento (Vite).
ORIGEM_FRONTEND=http://localhost:5173

# Assistente de cuidados (Seção 5.8 do documento).
#   simulado: responde só com o texto da base da ONG, sem chamar nada de fora.
#   groq:     a IA do Groq escreve a resposta a partir da base da ONG.
#             Chave grátis em https://console.groq.com/keys
# Se o Groq falhar ou o limite grátis acabar, o assistente volta sozinho
# para o modo simulado.
AGENTE_MODO=simulado
AGENTE_CHAVE_API=
# Opcional. Padrão: openai/gpt-oss-120b
AGENTE_MODELO=
# Com o Groq ligado, quando a base da ONG não cobre a dúvida o assistente
# pesquisa na internet e mostra os links. Para desligar: AGENTE_BUSCA_WEB=nao
AGENTE_BUSCA_WEB=sim
