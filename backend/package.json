{
  "name": "connectpatas-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST do ConnectPatas — plataforma de gestão de ONGs de proteção animal",
  "main": "src/servidor.js",
  "scripts": {
    "dev": "node --watch src/servidor.js",
    "start": "node src/servidor.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "connect-session-sequelize": "7.1.7",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "express-session": "1.19.0",
    "pg": "8.23.1",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "jest": "29.7.0",
    "sequelize-cli": "6.6.5",
    "supertest": "7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/_to_delete/"
    ],
    "globalSetup": "./tests/preparar.js"
  }
}
